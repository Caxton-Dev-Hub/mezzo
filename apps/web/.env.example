NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://mezzoescrow.xyz
NEXT_PUBLIC_MAX_UPLOAD_MB=25
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# "live" shows the Stellar wallet connect button; anything else (or unset) shows
# the "coming soon" badge instead. Inlined at build time, so changing it needs a
# dev-server restart or a rebuild. The network, asset and issuer are NOT set here:
# the web app reads them from the API's public GET /stellar/config, so they are
# never defined twice. Set STELLAR_MODE in apps/api/.env to match.
NEXT_PUBLIC_STELLAR_MODE=live
