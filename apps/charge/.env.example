# Charge App Environment Variables

# API endpoint (used by the charge app to communicate with the API)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Site URL (used for metadata, canonical URLs, and OG tags)
NEXT_PUBLIC_SITE_URL=https://charge.mezzoescrow.xyz

# Optional: Custom Next.js build output directory
# NEXT_DIST_DIR=.next
