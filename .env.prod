# Production Environment Variables for Mezzo + Charge
# Copy this to .env and fill in your actual values

# PostgreSQL
POSTGRES_USER=mezzo
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=mezzo

# JWT Secrets (generate random strings at least 32 characters)
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET_32_CHARS

# S3/MinIO Storage
S3_ACCESS_KEY_ID=mezzo-minio-user
S3_SECRET_ACCESS_KEY=CHANGE_ME_TO_A_SECURE_MINIO_PASSWORD
S3_PUBLIC_ENDPOINT=https://minio.mezzoescrow.xyz
S3_BUCKET=mezzo-evidence

# URLs
WEB_APP_URL=https://mezzoescrow.xyz
CHARGE_APP_URL=https://charge.mezzoescrow.xyz
CORS_ORIGINS=https://mezzoescrow.xyz,https://charge.mezzoescrow.xyz
NEXT_PUBLIC_API_URL=https://api.mezzoescrow.xyz
NEXT_PUBLIC_SITE_URL=https://mezzoescrow.xyz
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# Payment Provider (flutterwave or paystack)
PAYMENT_PROVIDER=flutterwave
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
FLUTTERWAVE_SECRET_KEY=FLWSECK-your_flutterwave_secret_key_here
FLUTTERWAVE_SECRET_HASH=your_flutterwave_webhook_hash_here

# Email/SMS Notifications
NOTIFICATION_EMAIL_PROVIDER=resend
NOTIFICATION_SMS_PROVIDER=termii
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@mezzoescrow.xyz
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=Mezzo

# AI Arbitration
ARBITRATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Admin Bootstrap
BOOTSTRAP_ADMIN_EMAILS=admin@mezzoescrow.xyz,youremail@example.com

# Google OAuth (optional)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stellar (optional - set to 'off' if not using)
STELLAR_MODE=off
STELLAR_NETWORK=testnet
STELLAR_ASSET_ISSUER=
STELLAR_CUSTODY_SECRET=
NEXT_PUBLIC_STELLAR_MODE=off

# WhatsApp (optional)
WHATSAPP_ENABLED=false
WHATSAPP_CLIENT_PROVIDER=fake

# Logging
LOG_LEVEL=info
