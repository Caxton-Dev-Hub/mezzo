# Production Environment Variables for Mezzo + Charge
# Copy this to .env and fill in your actual values
# OR run ./setup-production.sh to auto-generate secrets

# PostgreSQL
POSTGRES_USER=mezzo
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=mezzo

# JWT Secrets (use ./setup-production.sh to auto-generate)
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_chars

# S3/MinIO Storage
S3_ACCESS_KEY_ID=mezzo-minio-user
S3_SECRET_ACCESS_KEY=your_secure_minio_password_here
S3_PUBLIC_ENDPOINT=https://minio.mezzoescrow.xyz
S3_BUCKET=mezzo-evidence

# URLs (update with your actual domains)
WEB_APP_URL=https://mezzoescrow.xyz
CORS_ORIGINS=https://mezzoescrow.xyz,https://charge.mezzoescrow.xyz
NEXT_PUBLIC_API_URL=https://api.mezzoescrow.xyz
NEXT_PUBLIC_SITE_URL=https://mezzoescrow.xyz
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# Payment Provider
PAYMENT_PROVIDER=flutterwave
PAYSTACK_SECRET_KEY=sk_live_your_paystack_key
FLUTTERWAVE_SECRET_KEY=FLWSECK-your_flutterwave_key
FLUTTERWAVE_SECRET_HASH=your_webhook_hash

# Notifications
NOTIFICATION_EMAIL_PROVIDER=resend
NOTIFICATION_SMS_PROVIDER=termii
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=notifications@mezzoescrow.xyz
TERMII_API_KEY=your_termii_key
TERMII_SENDER_ID=Mezzo

# AI Arbitration
ARBITRATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# Admin Bootstrap
BOOTSTRAP_ADMIN_EMAILS=admin@mezzoescrow.xyz

# Optional: Google OAuth
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: Stellar
STELLAR_MODE=off
NEXT_PUBLIC_STELLAR_MODE=off

# Optional: WhatsApp
WHATSAPP_ENABLED=false
