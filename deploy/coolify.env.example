# Environment variables for the Coolify Docker Compose deployment of
# docker-compose.prod.yml. Paste these into the resource's "Environment
# Variables" tab (Developer view accepts this whole file at once).
#
# The five NEXT_PUBLIC_* values are read by browser code, so Next.js bakes them
# into the JavaScript bundle at build time. They MUST be ticked as build
# variables in Coolify or the browser bundle ships with the wrong API origin.
#
# Variables written as ${VAR:?} in docker-compose.prod.yml are required: Coolify
# refuses to deploy while they are empty. Everything else has a safe default.

# --- Build-time (tick "Build Variable" on each of these five) ---------------
NEXT_PUBLIC_API_URL=https://api.mezzoescrow.xyz
NEXT_PUBLIC_SITE_URL=https://mezzoescrow.xyz
NEXT_PUBLIC_MAX_UPLOAD_MB=25
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_STELLAR_MODE=off

# --- Required at runtime ----------------------------------------------------
# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -hex 32  (each must be at least 32 characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

WEB_APP_URL=https://mezzoescrow.xyz
CORS_ORIGINS=https://mezzoescrow.xyz,https://www.mezzoescrow.xyz

# The browser PUTs evidence straight to MinIO using a presigned URL, so this
# must be the public HTTPS origin the browser can reach — not http://minio:9000,
# which is what the API itself uses. Signing for the wrong origin is the classic
# "presign returns 200 but the upload fails" failure.
S3_PUBLIC_ENDPOINT=https://s3.mezzoescrow.xyz
S3_ACCESS_KEY_ID=mezzo
# openssl rand -base64 24  (this is also the MinIO root password)
S3_SECRET_ACCESS_KEY=
S3_BUCKET=mezzo-evidence

# --- Optional ---------------------------------------------------------------
# The only way to mint an admin/arbiter account; set it before the first deploy.
BOOTSTRAP_ADMIN_EMAILS=

# "fake" needs no credentials at all. Switching to paystack or flutterwave makes
# that provider's keys required at boot, so change both in the same save.
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

KYC_PROVIDER=fake
DOJAH_BASE_URL=
DOJAH_APP_ID=
DOJAH_PRIVATE_KEY=
DOJAH_WEBHOOK_SECRET=

# "dev" is rejected at boot when NODE_ENV=production. Use "off" or "live"; "live"
# additionally requires STELLAR_ASSET_ISSUER and STELLAR_CUSTODY_SECRET.
STELLAR_MODE=off
STELLAR_NETWORK=testnet
STELLAR_ASSET_ISSUER=
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_CUSTODY_SECRET=

ARBITRATION_PROVIDER=fake
ANTHROPIC_API_KEY=

NOTIFICATION_EMAIL_PROVIDER=fake
NOTIFICATION_SMS_PROVIDER=fake
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TERMII_API_KEY=
TERMII_SENDER_ID=Mezzo

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=

WHATSAPP_ENABLED=false
WHATSAPP_CLIENT_PROVIDER=fake
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

LOG_LEVEL=info
